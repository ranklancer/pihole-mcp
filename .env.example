# ─── Pi-hole MCP Server Configuration ─────────────────────────────
#
# Copy this file to .env and fill in your values.
#
# Multi-instance: list all instance names, comma-separated.
# For each instance, provide <UPPERCASED_NAME>_BASE_URL and _PASSWORD.

# Comma-separated instance names (no spaces around commas)
PIHOLE_INSTANCES=pihole

# ─── Instance: pihole ─────────────────────────────────────────────
PIHOLE_BASE_URL=http://pihole.example.com
PIHOLE_PASSWORD=your-pihole-api-password-here
# Set to "true" if the Pi-hole uses a self-signed TLS certificate
PIHOLE_INSECURE_TLS=false

# ─── Instance: pihole2 (uncomment to enable) ─────────────────────
# PIHOLE_INSTANCES=pihole,pihole2
# PIHOLE2_BASE_URL=https://pihole2.example.com
# PIHOLE2_PASSWORD=your-pihole2-api-password-here
# PIHOLE2_INSECURE_TLS=true

# ─── Server settings ─────────────────────────────────────────────
# Set to "stdio" to let the MCP client spawn the server on demand (HOST/PORT are then ignored)
# MCP_TRANSPORT=stdio
# Bind address. Defaults to loopback. Any non-loopback address (e.g. 0.0.0.0)
# is refused unless MCP_ALLOW_NON_LOOPBACK=true (the Docker image sets both).
HOST=127.0.0.1
# MCP_ALLOW_NON_LOOPBACK=true
PORT=3000

# ─── HTTP transport security ─────────────────────────────────────
# Optional bearer token required on /mcp (minimum 32 characters).
# Prefer the file form; generate with: openssl rand -hex 32
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_token
# MCP_AUTH_TOKEN=
# Hostnames accepted in the Host header (default: localhost,127.0.0.1,[::1])
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Browser origins allowed to call the server (default: none; requests with no
# Origin header, as sent by non-browser MCP clients, are always accepted)
# MCP_ALLOWED_ORIGINS=http://localhost:6274
NODE_ENV=production
TZ=UTC
